# ==============================================================================
# Foodie Express Frontend - Environment Configuration for Vercel / Local
# ==============================================================================
# In Vercel Project Settings:
# Go to: Project Settings -> Environment Variables
# Key:   API_BASE_URL (or FOODIE_API_BASE_URL)
# Value: https://foodie-backend-vc6z.onrender.com
# ==============================================================================

# Backend API Endpoint (Render Web Service)
API_BASE_URL=https://foodie-backend-vc6z.onrender.com
FOODIE_API_BASE_URL=https://foodie-backend-vc6z.onrender.com

# Frontend Environment
NODE_ENV=production
