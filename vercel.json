{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.css",
      "headers": [
        { "key": "Content-Type", "value": "text/css; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/video/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/css/customer.css", "destination": "/customer/css/customer.css" },
    { "source": "/css/admin.css", "destination": "/admin/css/admin.css" },
    { "source": "/css/supervisor.css", "destination": "/supervisor/css/supervisor.css" },
    { "source": "/css/global.css", "destination": "/shared/css/global.css" },
    { "source": "/css/components.css", "destination": "/shared/css/components.css" },
    { "source": "/js/customer.js", "destination": "/customer/js/customer.js" },
    { "source": "/js/admin.js", "destination": "/admin/js/admin.js" },
    { "source": "/js/supervisor.js", "destination": "/supervisor/js/supervisor.js" },
    { "source": "/js/api.js", "destination": "/shared/js/api.js" },
    { "source": "/js/app.js", "destination": "/customer/js/app.js" },
    { "source": "/js/cart.js", "destination": "/customer/js/cart.js" },
    { "source": "/js/menu.js", "destination": "/customer/js/menu.js" },
    { "source": "/js/auth.js", "destination": "/customer/js/auth.js" },
    { "source": "/js/payment.js", "destination": "/customer/js/payment.js" },
    { "source": "/js/wishlist.js", "destination": "/customer/js/wishlist.js" },

    { "source": "/", "destination": "/customer/index.html" },
    { "source": "/customer", "destination": "/customer/index.html" },
    { "source": "/customer/", "destination": "/customer/index.html" },
    { "source": "/menu", "destination": "/customer/menu.html" },
    { "source": "/cart", "destination": "/customer/cart.html" },
    { "source": "/payment", "destination": "/customer/payment.html" },
    { "source": "/orders", "destination": "/customer/orders.html" },
    { "source": "/order-details", "destination": "/customer/order-details.html" },
    { "source": "/reservations", "destination": "/customer/reservations.html" },
    { "source": "/profile", "destination": "/customer/profile.html" },
    { "source": "/wishlist", "destination": "/customer/wishlist.html" },
    { "source": "/login", "destination": "/customer/login.html" },
    { "source": "/signup", "destination": "/customer/signup.html" },
    { "source": "/logout", "destination": "/customer/logout.html" },
    { "source": "/about", "destination": "/customer/about.html" },
    { "source": "/contact", "destination": "/customer/contact.html" },
    { "source": "/veg", "destination": "/customer/veg.html" },
    { "source": "/nonveg", "destination": "/customer/nonveg.html" },
    { "source": "/indian", "destination": "/customer/indian.html" },
    { "source": "/snacks", "destination": "/customer/snacks.html" },
    { "source": "/dessert", "destination": "/customer/dessert.html" },
    { "source": "/success", "destination": "/customer/success.html" },

    { "source": "/admin", "destination": "/admin/dashboard.html" },
    { "source": "/admin/", "destination": "/admin/dashboard.html" },
    { "source": "/admin-dashboard", "destination": "/admin/dashboard.html" },
    { "source": "/admin-orders", "destination": "/admin/orders.html" },
    { "source": "/admin-order-details", "destination": "/admin/order-details.html" },
    { "source": "/admin-menu", "destination": "/admin/menu.html" },
    { "source": "/admin-categories", "destination": "/admin/categories.html" },
    { "source": "/admin-customers", "destination": "/admin/customers.html" },
    { "source": "/admin-payments", "destination": "/admin/payments.html" },
    { "source": "/admin-reservations", "destination": "/admin/reservations.html" },
    { "source": "/admin-messages", "destination": "/admin/messages.html" },
    { "source": "/admin-settings", "destination": "/admin/settings.html" },
    { "source": "/admin-login", "destination": "/admin/login.html" },

    { "source": "/supervisor", "destination": "/supervisor/dashboard.html" },
    { "source": "/supervisor/", "destination": "/supervisor/dashboard.html" },
    { "source": "/supervisor-dashboard", "destination": "/supervisor/dashboard.html" },
    { "source": "/supervisor-orders", "destination": "/supervisor/assigned-orders.html" },
    { "source": "/supervisor-order-details", "destination": "/supervisor/order-details.html" },
    { "source": "/supervisor-profile", "destination": "/supervisor/profile.html" }
  ]
}