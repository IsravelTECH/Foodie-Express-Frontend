{
  "version": 2,
  "routes": [
    { "handle": "filesystem" },

    { "src": "^/customer$", "dest": "/customer/", "status": 308 },
    { "src": "^/admin$", "dest": "/admin/dashboard.html", "status": 308 },
    { "src": "^/admin-dashboard/?$", "dest": "/admin/dashboard.html", "status": 308 },
    { "src": "^/supervisor$", "dest": "/supervisor/dashboard.html", "status": 308 },
    { "src": "^/supervisor-dashboard/?$", "dest": "/supervisor/dashboard.html", "status": 308 },

    { "src": "^/veg(?:\\.html)?$", "dest": "/customer/menu.html?cat=Veg", "status": 307 },
    { "src": "^/customer/veg(?:\\.html)?$", "dest": "/customer/menu.html?cat=Veg", "status": 307 },
    { "src": "^/nonveg(?:\\.html)?$", "dest": "/customer/menu.html?cat=Non-Veg", "status": 307 },
    { "src": "^/customer/nonveg(?:\\.html)?$", "dest": "/customer/menu.html?cat=Non-Veg", "status": 307 },
    { "src": "^/indian(?:\\.html)?$", "dest": "/customer/menu.html?cat=Indian", "status": 307 },
    { "src": "^/customer/indian(?:\\.html)?$", "dest": "/customer/menu.html?cat=Indian", "status": 307 },
    { "src": "^/snacks(?:\\.html)?$", "dest": "/customer/menu.html?cat=Snacks", "status": 307 },
    { "src": "^/customer/snacks(?:\\.html)?$", "dest": "/customer/menu.html?cat=Snacks", "status": 307 },
    { "src": "^/dessert(?:s)?(?:\\.html)?$", "dest": "/customer/menu.html?cat=Desserts", "status": 307 },
    { "src": "^/customer/dessert(?:s)?(?:\\.html)?$", "dest": "/customer/menu.html?cat=Desserts", "status": 307 },

    { "src": "^/menu(?:\\.html)?$", "dest": "/customer/menu.html", "status": 307 },
    { "src": "^/cart(?:\\.html)?$", "dest": "/customer/cart.html", "status": 307 },
    { "src": "^/payment(?:\\.html)?$", "dest": "/customer/payment.html", "status": 307 },
    { "src": "^/orders(?:\\.html)?$", "dest": "/customer/orders.html", "status": 307 },
    { "src": "^/order-details(?:\\.html)?$", "dest": "/customer/order-details.html", "status": 307 },
    { "src": "^/reservations(?:\\.html)?$", "dest": "/customer/reservations.html", "status": 307 },
    { "src": "^/profile(?:\\.html)?$", "dest": "/customer/profile.html", "status": 307 },
    { "src": "^/wishlist(?:\\.html)?$", "dest": "/customer/wishlist.html", "status": 307 },
    { "src": "^/login(?:\\.html)?$", "dest": "/customer/login.html", "status": 307 },
    { "src": "^/signup(?:\\.html)?$", "dest": "/customer/signup.html", "status": 307 },
    { "src": "^/logout(?:\\.html)?$", "dest": "/customer/logout.html", "status": 307 },
    { "src": "^/about(?:\\.html)?$", "dest": "/customer/about.html", "status": 307 },
    { "src": "^/contact(?:\\.html)?$", "dest": "/customer/contact.html", "status": 307 },
    { "src": "^/success(?:\\.html)?$", "dest": "/customer/success.html", "status": 307 },

    { "src": "^/customer/?$", "dest": "/customer/index.html" },
    { "src": "^/customer/([^/]+?)(?:\\.html)?$", "dest": "/customer/$1.html" },

    { "src": "^/admin/?$", "dest": "/admin/dashboard.html" },
    { "src": "^/admin/([^/]+?)(?:\\.html)?$", "dest": "/admin/$1.html" },

    { "src": "^/supervisor/?$", "dest": "/supervisor/dashboard.html" },
    { "src": "^/supervisor/([^/]+?)(?:\\.html)?$", "dest": "/supervisor/$1.html" },

    { "src": "^/(.*)$", "dest": "/$1" }
  ]
}